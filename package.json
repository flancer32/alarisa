{
  "name": "@flancer32/alarisa",
  "version": "0.3.0",
  "description": "Private, human-controlled personal digital avatar runtime for one Principal.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flancer32/alarisa.git"
  },
  "homepage": "https://github.com/flancer32/alarisa",
  "bugs": {
    "url": "https://github.com/flancer32/alarisa/issues"
  },
  "keywords": [
    "alarisa",
    "assistant",
    "avatar",
    "orchestration",
    "pwa",
    "nodejs",
    "teqfw"
  ],
  "types": "types.d.ts",
  "files": [
    ".env.example",
    "etc",
    "src",
    "web",
    "types.d.ts",
    "CHANGELOG.md",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "teqfw": {
    "fw": {
      "di": {
        "namespaces": [
          {
            "prefix": "Alarisa_",
            "path": "./src",
            "ext": ".mjs"
          }
        ]
      },
      "cli": {
        "plugin": "Alarisa_Bootstrap$",
        "command": {
          "default": "alarisa:start"
        },
        "commands": [
          {
            "id": "alarisa:start",
            "summary": "Start the Alarisa server.",
            "options": [
              {
                "name": "port",
                "kind": "number",
                "description": "Override the HTTP port."
              },
              {
                "name": "type",
                "kind": "string",
                "description": "Override the server type."
              },
              {
                "name": "data-root",
                "kind": "string",
                "description": "Override the runtime data root."
              }
            ],
            "component": "Alarisa_Cli_Command_Start$"
          },
          {
            "id": "auth:enroll",
            "summary": "Issue a Principal device enrollment URL.",
            "options": [
              {
                "name": "surface",
                "kind": "string",
                "defaultValue": "mob",
                "description": "Target surface: desk or mob."
              },
              {
                "name": "label",
                "kind": "string",
                "description": "Human-readable device label."
              },
              {
                "name": "ttl-minutes",
                "kind": "number",
                "description": "Enrollment lifetime in minutes."
              },
              {
                "name": "data-root",
                "kind": "string",
                "description": "Override the runtime data root."
              }
            ],
            "component": "Alarisa_Cli_Command_Enroll$"
          },
          {
            "id": "state:import-world-map",
            "summary": "Import the bundled World Map snapshot into durable State.",
            "options": [],
            "component": "Alarisa_Cli_Command_ImportWorldMap$"
          }
        ]
      }
    }
  },
  "scripts": {
    "start": "teq alarisa:start",
    "test:unit": "find test/unit -name '*.test.mjs' -print0 | xargs -0 node --test",
    "test": "npm run test:unit"
  },
  "dependencies": {
    "@flancer32/alarisa-back": "github:flancer32/alarisa-back#main",
    "@flancer32/alarisa-back-state": "github:flancer32/alarisa-back-state#main",
    "@flancer32/alarisa-comm": "github:flancer32/alarisa-comm#main",
    "@flancer32/alarisa-desk": "github:flancer32/alarisa-desk#main",
    "@flancer32/alarisa-mob": "github:flancer32/alarisa-mob#main",
    "@teqfw/cfg": "^2.0.0",
    "@teqfw/cli": "^2.1.0",
    "@teqfw/db": "github:teqfw/db#main",
    "@teqfw/log": "^2.0.0",
    "@teqfw/web": "^2.0.0",
    "pg": "^8.16.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2"
  },
  "allowScripts": {}
}
