# Web server configuration loaded from the project root.
# `@flancer32/teq-web` reads these settings through the TEQFW_WEB namespace.
TEQFW_WEB__HOST=127.0.0.1
TEQFW_WEB__PORT=3000
TEQFW_WEB__TYPE=http

# Alarisa application runtime configuration.
ALARISA__DATA_ROOT=var

# Durable-state PostgreSQL database. Set the password in the private .env file.
TEQFW_DB__CLIENT=pg
TEQFW_DB__HOST=127.0.0.1
TEQFW_DB__PORT=5432
TEQFW_DB__USER=alarisa
TEQFW_DB__PASSWORD=change-me
TEQFW_DB__DATABASE=alarisa

# WebAuthn relying-party and comfortable development defaults.
ALARISA__AUTH_ORIGIN=http://localhost:3000
ALARISA__AUTH_RP_ID=localhost
ALARISA__AUTH_RP_NAME=Alarisa
ALARISA__AUTH_CHALLENGE_MINUTES=5
ALARISA__AUTH_ENROLLMENT_MINUTES=15
ALARISA__AUTH_MOB_SESSION_DAYS=90
ALARISA__AUTH_DESK_SESSION_DAYS=180
ALARISA__AUTH_STEP_UP_MINUTES=30
